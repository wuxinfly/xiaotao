{
  "name": "@xiaotao-ai/dsh-adapter",
  "version": "0.1.0",
  "description": "XiaoTao 的 DeepSeek Harness（dsh）Adapter：把可移植 XiaoTao Core 注册为 dsh Skill，并基于 ctx.fs 提供确定性状态协议辅助能力。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts && node --test scripts/*.test.mjs",
    "test:package": "npm run build && node scripts/check-package.mjs"
  },
  "keywords": [
    "xiaotao",
    "deepseek",
    "harness",
    "dsh",
    "cordis",
    "skill",
    "adapter",
    "agent"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-skill": "*"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.5.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.5.0",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
