{
  "description": "恢复 XiaoTao、注入单 Worker Packet，并在 Stop 有界检查阶段保存回执。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'scripts','session-start.mjs')).href).then(m=>m.run())\"",
            "timeout": 5,
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'scripts','subagent-start.mjs')).href).then(m=>m.run())\"",
            "timeout": 5,
            "additionalContextLimit": 8000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'scripts','progress-check.mjs')).href).then(m=>m.run())\"",
            "timeout": 5,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'scripts','progress-check.mjs')).href).then(m=>m.run())\"",
            "timeout": 5,
            "additionalContextLimit": 2500
          }
        ]
      }
    ]
  }
}
