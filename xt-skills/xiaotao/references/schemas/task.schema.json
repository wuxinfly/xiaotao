{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.local/schemas/task.schema.json",
  "title": "XiaoTao Task Metadata",
  "type": "object",
  "required": [
    "id",
    "objective",
    "status",
    "created_at",
    "updated_at",
    "updated_by",
    "revision"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "status": { "enum": ["preparing", "active", "completed", "cancelled", "archive"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "updated_by": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "completed_at": { "type": "string", "format": "date-time" },
    "memory_pending": { "type": "boolean" },
    "memory_reviewed_at": { "type": "string", "format": "date-time" },
    "source_temporary": { "type": "string", "minLength": 1 },
    "promotion_transaction": { "type": "string", "minLength": 1 },
    "promoted_at": { "type": "string", "format": "date-time" }
  },
  "dependentRequired": {
    "source_temporary": ["promotion_transaction"],
    "promotion_transaction": ["source_temporary"],
    "promoted_at": ["source_temporary"]
  },
  "additionalProperties": false
}
