{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.local/schemas/memory-merge-request.schema.json",
  "title": "XiaoTao Memory Merge Request",
  "type": "object",
  "required": ["file_path", "base_entries", "ours_entries", "theirs_entries"],
  "properties": {
    "file_path": { "$ref": "#/$defs/path" },
    "base_entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/longTermEntry" }
    },
    "ours_entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/longTermEntry" }
    },
    "theirs_entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/longTermEntry" }
    },
    "merge_hints": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\\\)(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sourceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "longTermEntry": {
      "type": "object",
      "required": ["entry_id", "title", "memory_kind", "content", "source_refs"],
      "properties": {
        "entry_id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string", "minLength": 1 },
        "memory_kind": {
          "enum": ["fact", "experience", "principle", "decision", "constraint", "other"]
        },
        "content": { "type": "string", "minLength": 1 },
        "decision_context": { "$ref": "#/$defs/decisionContext" },
        "source_refs": { "$ref": "#/$defs/sourceRefs" },
        "status": {
          "enum": ["active", "superseded", "rejected"]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "memory_kind": { "not": { "const": "decision" } } },
            "required": ["memory_kind"]
          },
          "then": { "properties": { "decision_context": false } }
        }
      ]
    },
    "decisionContext": {
      "type": "object",
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "rejected_alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["alternative", "reason"],
            "properties": {
              "alternative": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
