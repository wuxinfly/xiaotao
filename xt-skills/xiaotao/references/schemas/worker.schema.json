{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.local/schemas/worker.schema.json",
  "title": "XiaoTao Worker Specification",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "source",
    "status",
    "capabilities",
    "scope",
    "responsibility",
    "inputs",
    "outputs",
    "instructions",
    "tools",
    "context",
    "permissions",
    "lifecycle"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "$ref": "#/$defs/slug" },
    "name": { "type": "string", "minLength": 1 },
    "source": { "enum": ["project", "learned", "temporary"] },
    "status": { "enum": ["active", "disabled"] },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "responsibility": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "preferred_model": { "type": ["string", "null"], "minLength": 1 },
    "instructions": { "$ref": "#/$defs/instructions" },
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "context": { "$ref": "#/$defs/context" },
    "permissions": { "$ref": "#/$defs/permissions" },
    "lifecycle": {
      "type": "object",
      "required": ["scope", "expires_at"],
      "properties": {
        "scope": { "enum": ["reusable", "task", "temporary", "session"] },
        "task_id": { "$ref": "#/$defs/storageId" },
        "temporary_id": { "$ref": "#/$defs/storageId" },
        "session_id": { "type": "string", "minLength": 1 },
        "expires_at": {
          "enum": ["never", "task-completion", "temporary-archive", "session-end"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "scope": { "const": "task" } }, "required": ["scope"] },
          "then": {
            "required": ["task_id"],
            "properties": {
              "temporary_id": false,
              "session_id": false,
              "expires_at": { "const": "task-completion" }
            }
          }
        },
        {
          "if": { "properties": { "scope": { "const": "temporary" } }, "required": ["scope"] },
          "then": {
            "required": ["temporary_id"],
            "properties": {
              "task_id": false,
              "session_id": false,
              "expires_at": { "const": "temporary-archive" }
            }
          }
        },
        {
          "if": { "properties": { "scope": { "const": "session" } }, "required": ["scope"] },
          "then": {
            "properties": {
              "task_id": false,
              "temporary_id": false,
              "expires_at": { "const": "session-end" }
            }
          }
        },
        {
          "if": { "properties": { "scope": { "const": "reusable" } }, "required": ["scope"] },
          "then": {
            "properties": {
              "task_id": false,
              "temporary_id": false,
              "session_id": false,
              "expires_at": { "const": "never" }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "source": { "const": "temporary" } }, "required": ["source"] },
      "then": {
        "properties": {
          "status": { "const": "active" },
          "lifecycle": {
            "type": "object",
            "properties": { "scope": { "enum": ["task", "temporary", "session"] } },
            "required": ["scope"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "source": { "enum": ["project", "learned"] } },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "lifecycle": {
            "type": "object",
            "properties": { "scope": { "const": "reusable" } },
            "required": ["scope"]
          }
        }
      }
    }
  ],
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "storageId": {
      "type": "string",
      "minLength": 1,
      "description": "与 Temporary/Task 目录名一致且文件系统安全的 ID。可以包含 CJK 和其他非 ASCII Unicode；只允许字母、数字、'_'、'.'、'-'，拒绝路径分隔符、空白、控制字符、shell 元字符、文件系统不安全标点，以及开头或结尾的点。",
      "pattern": "^(?!\\.)(?!.*[.]$)[\\p{L}\\p{N}._-]+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\\\)(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "instruction_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "instructions": {
      "type": "object",
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/instruction_ref" }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/instruction_ref" }
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["read_paths", "write_paths"],
      "properties": {
        "read_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "write_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "required": ["autonomous", "conditional"],
      "properties": {
        "autonomous": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "inspect-project",
              "run-nondestructive-checks",
              "write-xiaotao-state",
              "write-work-artifacts"
            ]
          }
        },
        "conditional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "edit-project-files",
              "external-action",
              "destructive-action",
              "secrets-operation",
              "permissions-change",
              "scope-expansion"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
