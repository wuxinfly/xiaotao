{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.local/schemas/worker-approval.schema.json",
  "title": "XiaoTao Worker Approval",
  "description": "A single immutable authority recording when an exact reusable Worker specification was approved for a project registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "approval_id",
    "worker_id",
    "worker_name",
    "registry_id",
    "registry_revision",
    "worker_digest",
    "approved_at",
    "approved_by"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "worker-approval" },
    "approval_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "worker_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "worker_name": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "registry_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "registry_revision": { "type": "integer", "minimum": 0 },
    "worker_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "approved_by": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }
  }
}
