{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.local/schemas/memory-followup.schema.json",
  "title": "XiaoTao Memory Follow-up Item",
  "type": "object",
  "required": [
    "followup_id",
    "title",
    "status",
    "created_at",
    "source_refs"
  ],
  "properties": {
    "followup_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pending", "resolved"] },
    "created_at": { "type": "string", "format": "date-time" },
    "source_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "related_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "uniqueItems": true
    },
    "resolved_at": { "type": "string", "format": "date-time" },
    "resolution": { "type": "string", "minLength": 1 },
    "resolution_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "pending" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "resolved_at": false,
          "resolution": false,
          "resolution_refs": false
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "resolved" } },
        "required": ["status"]
      },
      "then": {
        "required": ["resolved_at", "resolution"]
      }
    }
  ]
}
