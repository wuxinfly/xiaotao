{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.local/schemas/checkpoint.schema.json",
  "title": "XiaoTao immutable snapshot checkpoint request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "project", "kind", "target_id", "session_id", "base_revision", "base_hash", "input_hash", "snapshot", "source_hash", "proposal", "proposal_hash"],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "project": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["temporary", "task"] },
    "target_id": { "type": "string", "maxLength": 128, "pattern": "^(?![.])(?!.*[.]$)[\\p{L}\\p{N}._-]+$" },
    "session_id": { "type": "string", "minLength": 1 },
    "base_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
    "base_hash": { "$ref": "#/$defs/hash" },
    "input_hash": { "$ref": "#/$defs/hash" },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "source_hash": { "$ref": "#/$defs/hash" },
    "proposal": { "type": "string", "minLength": 1, "maxLength": 131072 },
    "proposal_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "items": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["objective", "confirmed", "rejected", "in_progress", "next", "open_questions", "source_refs"],
      "properties": {
        "objective": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "confirmed": { "$ref": "#/$defs/items" },
        "rejected": { "$ref": "#/$defs/items" },
        "in_progress": { "$ref": "#/$defs/items" },
        "next": { "$ref": "#/$defs/items" },
        "open_questions": { "$ref": "#/$defs/items" },
        "source_refs": { "$ref": "#/$defs/items" }
      }
    }
  }
}
