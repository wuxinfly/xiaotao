{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.local/schemas/instruction-registry.schema.json",
  "title": "XiaoTao Instruction Registry",
  "type": "object",
  "required": ["schema_version", "id", "source", "instructions"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "source": { "enum": ["builtin", "project"] },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "source_scope", "source_paths"],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "source_scope": { "enum": ["core", "project"] },
          "source_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!.*\\\\)(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "source": { "const": "builtin" } }, "required": ["source"] },
      "then": {
        "properties": {
          "instructions": {
            "type": "array",
            "items": { "type": "object", "properties": { "source_scope": { "const": "core" } } }
          }
        }
      },
      "else": {
        "properties": {
          "instructions": {
            "type": "array",
            "items": { "type": "object", "properties": { "source_scope": { "const": "project" } } }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
