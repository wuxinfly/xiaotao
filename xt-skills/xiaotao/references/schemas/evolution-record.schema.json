{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.dev/schemas/evolution-record.schema.json",
  "title": "Local Skill improvement suggestion (proposal only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_key", "status", "revision", "created_at", "updated_at", "observations", "decisions"],
  "properties": {
    "schema_version": { "const": 1 },
    "issue_key": { "$ref": "#/$defs/id" },
    "status": { "$ref": "#/$defs/status" },
    "revision": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "observations": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/observation" } },
    "decisions": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/decision" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$" },
    "status": { "enum": ["pending", "deferred", "resolved", "rejected"] },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S", "not": { "pattern": "[\\u0000-\\u0008\\u000b-\\u001f]" } },
    "shortText": { "type": "string", "allOf": [{ "$ref": "#/$defs/text" }], "maxLength": 160 },
    "longText": { "type": "string", "allOf": [{ "$ref": "#/$defs/text" }], "maxLength": 2000 },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_key", "observation_id", "title", "problem", "impact", "proposal", "acceptance", "evidence", "source_refs", "host", "skill_version", "observed_at"],
      "properties": {
        "issue_key": { "$ref": "#/$defs/id" },
        "observation_id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/shortText" },
        "problem": { "$ref": "#/$defs/longText" },
        "impact": { "type": "string", "allOf": [{ "$ref": "#/$defs/text" }], "maxLength": 1000 },
        "proposal": { "$ref": "#/$defs/longText" },
        "acceptance": { "$ref": "#/$defs/longText" },
        "evidence": { "$ref": "#/$defs/longText" },
        "host": { "type": "string", "allOf": [{ "$ref": "#/$defs/text" }], "maxLength": 80 },
        "skill_version": { "$ref": "#/$defs/shortText" },
        "observed_at": { "type": "string", "format": "date-time" },
        "source_refs": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": { "type": "string", "maxLength": 512, "pattern": "^(?!\\.xiaotao/evolution/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[^/\\\\:\\u0000-\\u001f]+(?:/[^/\\\\:\\u0000-\\u001f]+)*$" }
        }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["issue_key", "decision_id", "status", "actor", "reason", "decided_at", "observation_count"],
      "properties": {
        "issue_key": { "$ref": "#/$defs/id" },
        "decision_id": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/status" },
        "actor": { "$ref": "#/$defs/shortText" },
        "reason": { "$ref": "#/$defs/longText" },
        "change_ref": { "$ref": "#/$defs/longText" },
        "validation": { "$ref": "#/$defs/longText" },
        "decided_at": { "type": "string", "format": "date-time" },
        "observation_count": { "type": "integer", "minimum": 1, "maximum": 256 }
      },
      "allOf": [{ "if": { "properties": { "status": { "const": "resolved" } } }, "then": { "required": ["change_ref", "validation"] } }]
    }
  }
}
