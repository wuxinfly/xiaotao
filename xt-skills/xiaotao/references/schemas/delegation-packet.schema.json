{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.local/schemas/delegation-packet.schema.json",
  "title": "XiaoTao Worker Delegation Packet",
  "type": "object",
  "required": [
    "schema_version",
    "worker_id",
    "objective",
    "completion_condition",
    "instructions",
    "context_refs",
    "tools",
    "permissions",
    "host_adapter",
    "result_path",
    "handoff_path"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "worker_id": { "$ref": "#/$defs/slug" },
    "worker_snapshot_path": { "$ref": "#/$defs/path" },
    "objective": { "type": "string", "minLength": 1 },
    "completion_condition": { "type": "string", "minLength": 1 },
    "instructions": {
      "type": "object",
      "required": ["required_refs", "optional_refs", "resolved"],
      "properties": {
        "required_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/instruction_ref" }
        },
        "optional_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/instruction_ref" }
        },
        "resolved": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["ref", "source_scope", "source_paths", "sha256"],
            "properties": {
              "ref": { "$ref": "#/$defs/instruction_ref" },
              "source_scope": { "enum": ["core", "project"] },
              "source_paths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/path" }
              },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "context_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "properties": {
          "kind": {
            "enum": [
              "current-task",
              "current-temporary",
              "relevant-evidence",
              "memory",
              "current-state",
              "worker-spec",
              "other"
            ]
          },
          "path": { "$ref": "#/$defs/path" }
        },
        "additionalProperties": false
      }
    },
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "permissions": { "$ref": "#/$defs/permissions" },
    "host_adapter": {
      "type": "object",
      "required": ["id", "status", "unsupported_requirements"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["supported", "degraded", "unsupported"] },
        "unsupported_requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "supported" } }, "required": ["status"] },
          "then": { "properties": { "unsupported_requirements": { "type": "array", "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["degraded", "unsupported"] } }, "required": ["status"] },
          "then": { "properties": { "unsupported_requirements": { "type": "array", "minItems": 1 } } }
        }
      ],
      "additionalProperties": false
    },
    "result_path": { "$ref": "#/$defs/path" },
    "handoff_path": { "$ref": "#/$defs/path" }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "instruction_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\\\)(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "permissions": {
      "type": "object",
      "required": ["autonomous", "conditional"],
      "properties": {
        "autonomous": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "inspect-project",
              "run-nondestructive-checks",
              "write-xiaotao-state",
              "write-work-artifacts"
            ]
          }
        },
        "conditional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "edit-project-files",
              "external-action",
              "destructive-action",
              "secrets-operation",
              "permissions-change",
              "scope-expansion"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
