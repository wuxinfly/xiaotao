{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.local/schemas/worker-selection.schema.json",
  "title": "XiaoTao Worker Selection",
  "type": "object",
  "required": [
    "schema_version",
    "resolved_at",
    "requirements",
    "registry_versions",
    "resolution",
    "selected_workers",
    "rationale"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "resolved_at": { "type": "string", "format": "date-time" },
    "requirements": { "$ref": "capability-requirements.schema.json" },
    "registry_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["registry_id", "version"],
        "properties": {
          "registry_id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "resolution": { "enum": ["exact", "compatible", "composed", "generated", "no-match"] },
    "selected_workers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "snapshot_path": {
            "type": "string",
            "pattern": "^\\.xiaotao/(?:tasks/[^/]+|memory/temporary/active/[^/]+)/workers/[^/]+/spec\\.yaml$"
          },
          "ephemeral": { "const": true }
        },
        "oneOf": [
          { "required": ["snapshot_path"], "not": { "required": ["ephemeral"] } },
          { "required": ["ephemeral"], "not": { "required": ["snapshot_path"] } }
        ],
        "additionalProperties": false
      }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "blocker": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "resolution": { "const": "no-match" } }, "required": ["resolution"] },
      "then": {
        "required": ["blocker"],
        "properties": { "selected_workers": { "type": "array", "maxItems": 0 } }
      },
      "else": {
        "properties": { "selected_workers": { "type": "array", "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "resolution": { "enum": ["exact", "compatible", "generated"] } },
        "required": ["resolution"]
      },
      "then": {
        "properties": { "selected_workers": { "type": "array", "minItems": 1, "maxItems": 1 } }
      }
    },
    {
      "if": { "properties": { "resolution": { "const": "composed" } }, "required": ["resolution"] },
      "then": { "properties": { "selected_workers": { "type": "array", "minItems": 2 } } }
    }
  ],
  "additionalProperties": false
}
