{
  "schema_version": 2,
  "id": "bounded-investigator",
  "name": "Bounded Investigator",
  "source": "temporary",
  "status": "active",
  "capabilities": ["runtime-analysis"],
  "scope": ["example-task", "read-only-investigation"],
  "responsibility": "Investigate one bounded runtime issue and return evidence without editing product code.",
  "inputs": ["task context", "relevant source and evidence"],
  "outputs": ["evidence-backed findings", "Handoff"],
  "preferred_model": null,
  "instructions": {
    "required": ["contract:handoff", "policy:safety-boundary"],
    "optional": []
  },
  "tools": ["shell"],
  "context": {
    "read_paths": [".xiaotao/tasks/example/", "src/"],
    "write_paths": [".xiaotao/tasks/example/"]
  },
  "permissions": {
    "autonomous": ["inspect-project", "run-nondestructive-checks", "write-work-artifacts"],
    "conditional": []
  },
  "lifecycle": {
    "scope": "task",
    "task_id": "example",
    "expires_at": "task-completion"
  }
}
