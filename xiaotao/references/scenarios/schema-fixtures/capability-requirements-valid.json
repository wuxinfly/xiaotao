{
  "schema_version": 1,
  "objective": "Analyze and reduce React startup cost without changing visible behavior",
  "required_capabilities": ["react-performance", "runtime-profiling"],
  "optional_capabilities": ["bundle-analysis"],
  "available_tools": ["browser-trace", "bundle-inspector"],
  "context": {
    "read_paths": ["src/", "dist/stats.json"],
    "write_paths": [".xiaotao/tasks/example/artifacts/"]
  },
  "permission_ceiling": {
    "autonomous": ["inspect-project", "run-nondestructive-checks", "write-work-artifacts"],
    "conditional": []
  },
  "constraints": ["Do not change visible behavior"]
}
