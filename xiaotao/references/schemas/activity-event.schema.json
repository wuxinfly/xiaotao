{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.local/schemas/activity-event.schema.json",
  "title": "XiaoTao Activity Event",
  "description": "从现有权威记录确定性派生的活动条目，不是可单独追加或修改的事实源。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "occurred_at",
    "event_type",
    "title",
    "summary",
    "source_refs",
    "status"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^activity-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "enum": [
        "task_completed",
        "temporary_promoted",
        "decision_approved",
        "decision_superseded",
        "playbook_approved",
        "playbook_superseded",
        "checkpoint_recovered",
        "worker_approved"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "status": {
      "const": "completed"
    }
  }
}
