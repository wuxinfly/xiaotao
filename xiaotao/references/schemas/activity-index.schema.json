{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.local/schemas/activity-index.schema.json",
  "title": "XiaoTao Activity Index",
  "description": "从权威 Task 记录确定性重建的派生缓存，不是事实源。缺失或损坏时可删除重建。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "source_digest", "events"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "events": {
      "type": "array",
      "items": { "$ref": "activity-event.schema.json" }
    }
  }
}
