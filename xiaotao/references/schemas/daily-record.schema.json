{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.local/schemas/daily-record.schema.json",
  "title": "XiaoTao authoritative daily project note",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^daily-\\d{4}-\\d{2}-\\d{2}-[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "topic_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "details": {
      "type": "string",
      "maxLength": 6000
    },
    "source_refs": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "work_ref": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "path"
          ],
          "properties": {
            "kind": {
              "enum": [
                "task",
                "temporary"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "与 Temporary/Task 目录名一致且文件系统安全的 ID。可以包含 CJK 和其他非 ASCII Unicode；只允许字母、数字、'_'、'.'、'-'，拒绝路径分隔符、空白、控制字符、shell 元字符、文件系统不安全标点，以及开头或结尾的点。",
              "pattern": "^(?!\\.)(?!.*[.]$)[\\p{L}\\p{N}._-]+$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "topic_id",
    "date",
    "timezone",
    "title",
    "summary",
    "details",
    "source_refs",
    "work_ref",
    "occurred_at",
    "revision",
    "updated_at",
    "updated_by",
    "request_id",
    "request_hash"
  ]
}
