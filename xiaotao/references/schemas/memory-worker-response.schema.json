{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.local/schemas/memory-worker-response.schema.json",
  "title": "XiaoTao Memory Worker Response",
  "type": "object",
  "required": ["status", "request_file", "current"],
  "properties": {
    "status": { "const": "completed" },
    "request_file": { "type": "string", "minLength": 1 },
    "current": {
      "type": "object",
      "required": ["content"],
      "properties": { "content": { "type": "object" } },
      "additionalProperties": false
    },
    "references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" }
    },
    "discarded": {},
    "long_term_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/longTermCandidate" }
    },
    "playbook_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/playbookCandidate" }
    },
    "notes": {}
  },
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "storageId": {
      "type": "string",
      "minLength": 1,
      "description": "与 Temporary/Task 目录名一致且文件系统安全的 ID。可以包含 CJK 和其他非 ASCII Unicode；拒绝路径分隔符、空白、控制字符、shell 元字符、文件系统不安全标点，以及开头或结尾的点（因此不能使用 '.'、'..' 和会被静默规范化的名称）。",
      "pattern": "^(?!\\.)(?!.*[.]$)[\\p{L}\\p{N}._-]+$"
    },
    "sourceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "reference": {
      "type": "object",
      "required": ["title", "content", "source_refs"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "content": { "type": "string" },
        "source_refs": { "$ref": "#/$defs/sourceRefs" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["type", "id", "created_at"],
      "properties": {
        "type": { "enum": ["temporary", "task", "user-message"] },
        "id": { "$ref": "#/$defs/storageId" },
        "workspace_id": { "$ref": "#/$defs/storageId" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "required": ["classification", "entry_ids"],
      "properties": {
        "classification": {
          "enum": ["novel", "duplicate", "overlap", "conflict", "low-value"]
        },
        "entry_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "playbookMatch": {
      "type": "object",
      "required": ["classification", "playbook_ids"],
      "properties": {
        "classification": {
          "enum": ["novel", "duplicate", "overlap", "conflict", "low-value"]
        },
        "playbook_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "longTermCandidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "title",
        "memory_kind",
        "action",
        "match",
        "conflict_status",
        "content",
        "rationale",
        "source",
        "source_refs"
      ],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string", "minLength": 1 },
        "memory_kind": {
          "enum": ["fact", "experience", "principle", "decision", "constraint", "other"]
        },
        "action": { "enum": ["UPDATE", "MERGE", "CREATE", "SKIP"] },
        "match": { "$ref": "#/$defs/match" },
        "conflict_status": {
          "enum": ["none", "pending-confirmation", "confirmed"]
        },
        "content": { "type": "string", "minLength": 1 },
        "valid_from": { "type": "string", "format": "date-time" },
        "valid_until": { "type": "string", "format": "date-time" },
        "decision_context": { "$ref": "#/$defs/decisionContext" },
        "rationale": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "source_refs": { "$ref": "#/$defs/sourceRefs" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "search_hints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "memory_kind": { "not": { "const": "decision" } } },
            "required": ["memory_kind"]
          },
          "then": { "properties": { "decision_context": false } }
        },
        {
          "if": {
            "properties": {
              "memory_kind": { "not": { "enum": ["fact", "constraint"] } }
            },
            "required": ["memory_kind"]
          },
          "then": {
            "properties": {
              "valid_from": false,
              "valid_until": false
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "CREATE" } }, "required": ["action"] },
          "then": {
            "properties": {
              "match": {
                "type": "object",
                "properties": {
                  "classification": { "const": "novel" },
                  "entry_ids": { "type": "array", "maxItems": 0 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "UPDATE" } }, "required": ["action"] },
          "then": {
            "properties": {
              "match": {
                "type": "object",
                "properties": {
                  "classification": { "enum": ["overlap", "conflict"] },
                  "entry_ids": { "type": "array", "minItems": 1, "maxItems": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "MERGE" } }, "required": ["action"] },
          "then": {
            "properties": {
              "match": {
                "type": "object",
                "properties": {
                  "classification": { "enum": ["overlap", "conflict"] },
                  "entry_ids": { "type": "array", "minItems": 2 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "SKIP" } }, "required": ["action"] },
          "then": {
            "properties": {
              "match": {
                "type": "object",
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "classification": { "const": "duplicate" },
                      "entry_ids": { "type": "array", "minItems": 1 }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "classification": { "const": "low-value" },
                      "entry_ids": { "type": "array", "maxItems": 0 }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "match": {
                "type": "object",
                "properties": { "classification": { "const": "conflict" } },
                "required": ["classification"]
              }
            },
            "required": ["match"]
          },
          "then": {
            "properties": {
              "conflict_status": { "enum": ["pending-confirmation", "confirmed"] }
            }
          },
          "else": {
            "properties": { "conflict_status": { "const": "none" } }
          }
        }
      ]
    },
    "decisionContext": {
      "type": "object",
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "rejected_alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["alternative", "reason"],
            "properties": {
              "alternative": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "playbookCandidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "title",
        "trigger",
        "steps",
        "checks",
        "action",
        "match",
        "rationale",
        "source",
        "source_refs",
        "evidence_refs",
        "status"
      ],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "action": { "enum": ["UPDATE", "MERGE", "CREATE", "SKIP"] },
        "match": { "$ref": "#/$defs/playbookMatch" },
        "rationale": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "source_refs": { "$ref": "#/$defs/sourceRefs" },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" },
        "status": { "const": "candidate" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "CREATE" } }, "required": ["action"] },
          "then": {
            "properties": {
              "match": {
                "type": "object",
                "properties": {
                  "classification": { "const": "novel" },
                  "playbook_ids": { "type": "array", "maxItems": 0 }
                }
              },
              "evidence_refs": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "UPDATE" } }, "required": ["action"] },
          "then": {
            "properties": {
              "match": {
                "type": "object",
                "properties": {
                  "classification": { "enum": ["overlap", "conflict"] },
                  "playbook_ids": { "type": "array", "minItems": 1, "maxItems": 1 }
                }
              },
              "evidence_refs": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "MERGE" } }, "required": ["action"] },
          "then": {
            "properties": {
              "match": {
                "type": "object",
                "properties": {
                  "classification": { "enum": ["overlap", "conflict"] },
                  "playbook_ids": { "type": "array", "minItems": 2 }
                }
              },
              "evidence_refs": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "SKIP" } }, "required": ["action"] },
          "then": {
            "properties": {
              "match": {
                "type": "object",
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "classification": { "const": "duplicate" },
                      "playbook_ids": { "type": "array", "minItems": 1 }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "classification": { "const": "low-value" },
                      "playbook_ids": { "type": "array", "maxItems": 0 }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
