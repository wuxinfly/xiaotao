{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.local/schemas/timeline-event.schema.json",
  "title": "XiaoTao Project Memory Timeline Event",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "summary",
    "occurred_at",
    "source_refs"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^activity-[0-9]{8}-[0-9a-f]{12}$"
    },
    "event_type": {
      "enum": [
        "task_completed",
        "temporary_promoted",
        "decision_approved",
        "decision_superseded",
        "playbook_approved",
        "playbook_superseded",
        "milestone",
        "checkpoint_recovered"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
