{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.local/schemas/global-preference.schema.json",
  "title": "XiaoTao Global User Preference",
  "type": "object",
  "required": [
    "preference_id",
    "category",
    "statement",
    "confidence",
    "source_refs",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "preference_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "category": {
      "enum": [
        "communication",
        "coding_style",
        "testing",
        "architecture",
        "workflow",
        "tooling",
        "other"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string"
    },
    "confidence": {
      "enum": ["observed", "confirmed"]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
