{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.local/schemas/memory-source.schema.json",
  "title": "XiaoTao Immutable Memory Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "source_kind",
    "recorded_at",
    "recorded_by",
    "content",
    "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_id": {
      "type": "string",
      "pattern": "^src-[0-9a-f]{16}$"
    },
    "source_kind": { "const": "user-message" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "recorded_by": { "type": "string", "minLength": 1 },
    "content": { "type": "string", "minLength": 1 },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
