{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaotao.local/schemas/memory-index.schema.json",
  "title": "XiaoTao Memory Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "source_digest", "entries", "pending_followups"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "pending_followups": {
      "type": "array",
      "items": { "$ref": "#/$defs/pendingFollowup" }
    }
  },
  "$defs": {
    "storageId": {
      "type": "string",
      "minLength": 1,
      "description": "与 Temporary/Task 目录名一致且文件系统安全的 ID。可以包含 CJK 和其他非 ASCII Unicode；只允许字母、数字、'_'、'.'、'-'，拒绝路径分隔符、空白、控制字符、shell 元字符、文件系统不安全标点，以及开头或结尾的点。",
      "pattern": "^(?!\\.)(?!.*[.]$)[\\p{L}\\p{N}._-]+$"
    },
    "uniqueStrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "pendingFollowup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "followup_id",
        "title",
        "status",
        "created_at",
        "source_refs",
        "related_ids",
        "path"
      ],
      "properties": {
        "followup_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "status": { "const": "pending" },
        "created_at": { "type": "string", "format": "date-time" },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "uniqueItems": true
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_id",
        "layer",
        "record_type",
        "title",
        "summary",
        "path",
        "locator",
        "status",
        "memory_kind",
        "tags",
        "aliases",
        "search_hints",
        "updated_at",
        "stale"
      ],
      "properties": {
        "memory_id": { "$ref": "#/$defs/storageId" },
        "layer": { "enum": ["temporary", "task", "long-term"] },
        "record_type": {
          "enum": ["long-term-entry", "temporary", "task", "worker-state"]
        },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "locator": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "disputed", "superseded", "rejected", "archived"] },
        "memory_kind": {
          "type": ["string", "null"],
          "enum": ["fact", "experience", "principle", "decision", "constraint", "other", null]
        },
        "tags": { "$ref": "#/$defs/uniqueStrings" },
        "aliases": { "$ref": "#/$defs/uniqueStrings" },
        "search_hints": { "$ref": "#/$defs/uniqueStrings" },
        "updated_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "stale": {
          "type": ["boolean", "null"]
        },
        "valid_from": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "valid_until": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "temporal_state": {
          "enum": ["timeless", "not-yet-valid", "current", "expired"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "layer": { "const": "long-term" } },
            "required": ["layer"]
          },
          "then": {
            "required": ["valid_from", "valid_until", "temporal_state"],
            "properties": {
              "record_type": { "const": "long-term-entry" },
              "memory_kind": {
                "enum": ["fact", "experience", "principle", "decision", "constraint", "other"]
              },
              "stale": { "type": "null" },
              "valid_from": { "type": ["string", "null"], "format": "date-time" },
              "valid_until": { "type": ["string", "null"], "format": "date-time" },
              "temporal_state": { "enum": ["timeless", "not-yet-valid", "current", "expired"] }
            }
          }
        },
        {
          "if": {
            "properties": { "layer": { "const": "temporary" } },
            "required": ["layer"]
          },
          "then": {
            "properties": {
              "record_type": { "const": "temporary" },
              "memory_kind": { "const": null },
              "stale": { "type": "boolean" }
            }
          }
        },
        {
          "if": {
            "properties": { "layer": { "const": "task" } },
            "required": ["layer"]
          },
          "then": {
            "properties": {
              "record_type": { "enum": ["task", "worker-state"] },
              "memory_kind": { "const": null },
              "stale": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
