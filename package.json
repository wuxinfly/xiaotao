{
  "name": "xiaotao-ai-workflow",
  "version": "0.2.0",
  "description": "面向结果的 AI 协作 Skill，支持动态 Worker 和多宿主安装 CLI",
  "type": "module",
  "bin": {
    "xiaotao": "bin/xiaotao.js"
  },
  "files": [
    "bin/",
    "cli/",
    "xiaotao/",
    "!xiaotao/**/__pycache__/**",
    "!xiaotao/**/*.pyc",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:contracts": "pwsh -File scripts/verify-contracts.ps1",
    "dsh:install:local": "node adapters/deepseek-harness/scripts/install-local.mjs",
    "dsh:audit:checkpoint": "node adapters/deepseek-harness/scripts/audit-checkpoint.mjs",
    "codex:install:local": "node adapters/codex/install-local.mjs",
    "verify": "npm test && npm run test:contracts && npm pack --dry-run"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IHongTaoI/xiaotao.git"
  },
  "homepage": "https://github.com/IHongTaoI/xiaotao#readme",
  "bugs": {
    "url": "https://github.com/IHongTaoI/xiaotao/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "skill",
    "workflow",
    "codex",
    "claude-code",
    "opencode"
  ],
  "publishConfig": {
    "access": "public"
  }
}
