---
import "../styles/global.css";
const repo = "https://github.com/IHongTaoI/xiaotao";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
const docs = `${repo}/tree/master/xt-skills`;
const capabilities = [
 ["01", "目标与协作", "告诉小涛你想得到什么结果。它按任务需要组织分析、实现和验证，汇总结果、风险与需要你决定的事。", "目标理解 · Worker · 结果汇报"],
 ["02", "项目记忆", "把探索、任务状态与稳定经验分层保存。留下项目背景和关键决定，后续协作时减少重复交代。", "Temporary · Task · Long-term"],
 ["03", "恢复与交接", "通过 Checkpoint 保存可恢复状态，通过 Handoff 交接执行结果，让后续会话能依据项目记录继续。", "Checkpoint · Handoff"],
 ["04", "多宿主适配", "把小涛带到你正在使用的 Agent 环境。协作规则与项目记忆留在项目中，适配器负责连接宿主能力。", "Codex · Claude Code · DSH · Antigravity"],
];
const commands = [
 {name:"安装", command:"npx @wxfly/xiaotao@latest init", description:"在项目目录的交互式终端运行，检测环境、选择宿主并完成安装自检。"},
 {name:"更新", command:"npx @wxfly/xiaotao@latest update", description:"更新当前项目已选择的宿主；更新的是电脑上共享的小涛安装。"},
 {name:"诊断", command:"npx @wxfly/xiaotao@latest doctor", description:"检查安装状态、Skill 文件和管理标记，不修改任何文件。"},
];
---
<!doctype html>
<html lang="zh-CN">
 <head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/>
  <meta name="description" content="了解小涛 Agent Skill：目标协作、项目记忆、恢复交接与多宿主适配。查看安装方法、管理命令及使用示例。"/>
  <meta name="theme-color" content="#38bdf8"/><link rel="icon" href={`${base}/mascot-ripple.png`}/>
  <title>Skills · 小涛 XiaoTao</title>
 </head>
 <body>
  <header><div class="nav wrap"><a class="brand" href={`${base}/`}><img src={`${base}/mascot-ripple.png`} alt=""/>小涛 <span>XiaoTao</span></a><nav aria-label="Skills 导航"><a href={`${base}/`}>返回首页</a><a href="#install">安装</a><a href={docs}>源码 ↗</a></nav><a class="github" href={repo}>GitHub ↗</a></div></header>
  <main>
   <section class="skills-intro"><div class="wrap skills-intro-inner"><div><a class="back" href={`${base}/`}>← 小涛首页</a><p class="eyebrow">XIAOTAO AGENT SKILL</p><h1>把小涛，带进你的项目。</h1><p class="lead">在熟悉的 Agent 环境里，让小涛帮你组织协作、记住项目，并把工作接着往下做。</p><div class="actions"><a class="button primary" href="#install">安装小涛 Skill ↓</a><a class="button secondary" href={docs}>阅读完整文档 ↗</a></div></div><img src={`${base}/mascot-ripple.png`} alt="小涛海浪角色" fetchpriority="high"/></div></section>
   <section class="section wrap"><div class="section-heading"><p class="eyebrow">WORK WITH PROJECT CONTEXT</p><h2>从一次对话，到持续协作。</h2><p>小涛 Skill 是面向软件协作的能力包，安装到现有 Agent 宿主中使用。</p></div><div class="feature-grid">{capabilities.map(([n,title,copy,tags])=><article class="feature"><span class="number">{n} /</span><h3>{title}</h3><p>{copy}</p><span class="skill-tags">{tags}</span></article>)}</div><p class="product-note">这页介绍的是小涛 Skill。首页的反代客户端是另一个模块；下面的 npm 命令用于安装 Skill，不用于安装反代客户端。</p></section>
   <section id="install" class="section install-band"><div class="wrap"><div class="section-heading"><p class="eyebrow">START IN YOUR PROJECT</p><h2>在项目里，一条命令开始。</h2><p>运行前准备 Node.js 20.19+、Python 和 PowerShell。</p></div><div class="command-list">{commands.map(c=><article class="command-row"><div><h3>{c.name}</h3><p>{c.description}</p></div><div class="command-box"><code>{c.command}</code><button type="button" data-copy={c.command} aria-label={`复制${c.name}命令`} title={`复制${c.name}命令`}>复制</button></div></article>)}</div><p class="install-note">Skill 安装在用户级宿主目录。每个项目通过 <code>.xiaotao/installation.json</code> 记录启用的宿主，多个项目共用同一份用户级安装。</p><p class="copy-status" role="status" aria-live="polite"></p></div></section>
   <section class="section wrap skill-usage"><div><p class="eyebrow">JUST TALK TO XIAOTAO</p><h2>安装后，直接和小涛说。</h2><p>在项目对应的宿主中提出目标，也可以明确要求先调查、先评审，或开始修改。</p><a class="text-link" href={`${docs}#在宿主中使用`}>查看使用说明 →</a></div><div class="prompts"><blockquote>小涛，帮我评审这个方案，只说主要风险和建议。</blockquote><blockquote>小涛，先调查这个问题，不要改代码。</blockquote><blockquote>小涛，按刚才确定的方案开始修改。</blockquote></div></section>
   <section class="section host-band"><div class="wrap"><div class="section-heading"><p class="eyebrow">IN YOUR EXISTING WORKSPACE</p><h2>选择你正在使用的宿主。</h2><p>安装、配置和能力边界以各宿主文档为准。</p></div><div class="host-links"><a href={docs}>Codex / 通用 Agent Skills ↗</a><a href={docs}>Claude Code ↗</a><a href={`${docs}/adapters/deepseek-harness`}>DSH ↗</a><a href={`${docs}/adapters/antigravity`}>Antigravity ↗</a><a href={`${docs}/adapters/zcode`}>ZCode ↗</a></div><p class="install-note">ZCode 需在初始化准备本地插件市场后，再到 ZCode 客户端安装启用；具体限制见适配说明。</p></div></section>
  </main>
  <footer class="wrap"><a class="brand" href={`${base}/`}><img src={`${base}/mascot-ripple.png`} alt=""/>小涛 <span>XiaoTao</span></a><p>让项目记住进展，也记住为什么。</p><div><a href={`${base}/`}>首页</a><a href={docs}>Skill 文档 ↗</a></div></footer>
  <script>
   document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach(button => {
    button.addEventListener("click", async () => {
     const status = document.querySelector(".copy-status");
     try {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      if (status) status.textContent = "命令已复制。";
     } catch {
      if (status) status.textContent = "无法访问剪贴板，请选中命令文本复制。";
     }
    });
   });
  </script>
 </body>
</html>
<style>
 .skills-intro{background:#eaf8ff;overflow:hidden}.skills-intro-inner{display:grid;grid-template-columns:1.5fr 1fr;align-items:center;padding-block:55px;gap:25px}.back{display:inline-block;color:#52758b;font-size:13px;margin-bottom:32px}.skills-intro h1{font-size:40px;line-height:1.4;margin:0 0 20px}.lead{font-size:17px;line-height:1.9;color:#52758b;max-width:610px}.skills-intro img{width:390px}.skill-tags{font-size:12px;color:#087cae;line-height:1.8}.product-note{border-left:3px solid #38bdf8;padding:15px 20px;margin:30px 0 0;background:#f4fbff;font-size:13px;line-height:1.9;color:#52758b}.install-band,.host-band{background:#f5fbff;border-block:1px solid #e4f2fa}.command-list{border-top:1px solid #d9ecf5}.command-row{display:grid;grid-template-columns:1fr 1.3fr;align-items:center;gap:35px;padding-block:26px;border-bottom:1px solid #d9ecf5}.command-row h3{font-size:18px;margin:0 0 8px}.command-row p,.install-note{font-size:13px;line-height:1.9;color:#657b8d;margin:0}.command-box{display:flex;align-items:center;gap:14px;background:#133347;color:#e8f8ff;padding:20px;border-radius:6px;min-width:0}.command-box code{font-size:13px;overflow-wrap:anywhere;flex:1;min-width:0}.command-box button{border:1px solid #497187;border-radius:4px;background:transparent;color:#d8f3ff;padding:7px 10px;flex-shrink:0;font-size:12px}.command-box button:hover{background:#25495e}.install-note{margin-top:25px;overflow-wrap:anywhere}.copy-status{min-height:24px;color:#087d69;font-size:13px}.skill-usage{display:grid;grid-template-columns:1fr 1fr;gap:65px;align-items:center}.skill-usage h2{font-size:30px;line-height:1.5;margin:0 0 20px}.skill-usage p:not(.eyebrow){font-size:14px;line-height:1.9;color:#657b8d}.prompts{display:grid;gap:14px}.prompts blockquote{margin:0;border-left:2px solid #38bdf8;background:#f1faff;padding:20px;font-size:14px;line-height:1.8}.host-links{display:flex;flex-wrap:wrap;justify-content:center;gap:15px 28px}.host-links a{font-size:14px;color:#087cae;padding:10px 0;border-bottom:1px solid #bde6f8}.host-links a:hover{color:#102439}@media(max-width:700px){.skills-intro-inner{grid-template-columns:1fr;padding-block:30px;gap:0}.skills-intro h1{font-size:29px}.lead{font-size:15px}.skills-intro img{width:250px;justify-self:center}.back{margin-bottom:25px}.command-row,.skill-usage{grid-template-columns:1fr;gap:20px}.command-box{padding:15px}.command-box code{font-size:12px}.skill-usage h2{font-size:26px}.host-links{justify-content:flex-start}.nav #navigation{display:flex;position:static;border:0;padding:0;gap:14px;font-size:12px}.nav #navigation a:last-child{display:none}.nav{gap:12px}.brand span{display:none}}
</style>
