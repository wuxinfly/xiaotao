---
import "../styles/global.css";
const repo = "https://github.com/wuxinfly/xiaotao";
const downloadUrl = "https://github.com/wuxinfly/xiaotao/releases/download/v1.0.2/xiaotao-v1.0.2.exe";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
const mascot = `${base}/mascot-ripple.png`;
const providers = [{ name: "Trae", mark: "T", icon: "trae.svg" }, { name: "Codex", mark: "◎", icon: "codex.png" }, { name: "Antigravity", mark: "✦", icon: "antigravity.svg" }, { name: "WorkBuddy", mark: "W", icon: "workbuddy.png" }, { name: "Qoder", mark: "Q", icon: "qoder.png" }];
const features = [
 {title:"多来源账号",copy:"集中管理不同来源的账号，按模型来源与启用顺序路由请求。",heading:"账号统一管理",items:["添加并管理账号","查看账号额度","按来源选择模型"]},
 {title:"本地 API 代理",copy:"提供兼容 OpenAI Chat Completions 的本地接口，让支持的工具接入模型。",heading:"接入你的工作流",items:["本地模型列表","Chat Completions 接口","代理访问密钥"]},
 {title:"模型目录",copy:"查看不同账号的模型目录和完整调用 ID，便于在工具中配置。",heading:"挑选合适的模型",items:["按账号查看模型","复制模型调用 ID","刷新模型目录"]},
 {title:"用量与请求",copy:"在仪表盘查看用量和最近请求，通过独立浮窗留意进行中的请求。",heading:"请求状态一目了然",items:["查看用量统计","查看最近请求","关注进行中的请求"]},
];
---
<!doctype html>
<html lang="zh-CN">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="小涛 Windows 客户端：集中管理多个模型来源，通过本地 API 反代接入你的工具。"/><meta name="theme-color" content="#38bdf8"/><link rel="icon" href={mascot}/><title>小涛 XiaoTao · 模型反代与账号管理</title></head>
<body class="landing">
<header><div class="nav wrap"><a class="brand" href={`${base}/`}><img src={mascot} alt=""/>小涛 <span>XiaoTao</span></a><button class="menu" aria-label="打开导航" aria-controls="navigation" aria-expanded="false">☰</button><nav id="navigation"><a href="#proxy">模型接入</a><a href="#tools">模型来源</a><a href="#partner">小涛能做什么</a><a href={`${base}/skills/`}>Skills</a></nav><a class="github" href={repo}>GitHub ↗</a></div></header>
<main>
<section class="hero"><div class="wrap hero-inner"><div class="hero-copy"><p class="eyebrow">XIAOTAO FOR WINDOWS  /  V1.0.2</p><h1>模型反代 · 本地运行</h1><h2>多个模型来源，<br/><em>一个接入入口。</em></h2><p class="intro">集中管理账号与额度，通过本地 API 反代<br/>把熟悉的模型接入你的工具。</p><div class="actions"><a class="button primary" href={downloadUrl}>下载 Windows 客户端 <span>↓</span></a><a class="button secondary" href={repo}>查看 GitHub ↗</a></div><p class="download-note">Windows x64 · v1.0.2 体验版 · 下载后直接运行</p><div class="hero-tools">{providers.map(p=><span><img class="provider-icon" src={base + "/providers/" + p.icon} alt=""/>{p.name}</span>)}</div></div><img class="hero-mascot" src={mascot} alt="海浪环绕的小涛" fetchpriority="high"/><p class="hero-note">连接多个模型来源，<br/>让你的工具直接使用。</p></div></section>
<section class="wrap demo-section" aria-label="模型反代功能示意"><div class="proxy-demo"><div class="proxy-demo-head"><div><span class="proxy-status"></span> 小涛本地代理</div><span>运行示意</span></div><div class="proxy-demo-body"><div class="proxy-sources"><small>模型来源</small>{providers.map(p=><div><img class="provider-icon" src={base + "/providers/" + p.icon} alt=""/><strong>{p.name}</strong><span>→</span></div>)}</div><div class="proxy-endpoint"><p class="eyebrow">ONE LOCAL ENDPOINT</p><h3>接入一次，<br/>连接多个模型。</h3><p>使用本地代理地址和访问密钥，在兼容的工具中调用已接入的模型。</p><div class="endpoint-card"><small>本地接口示例</small><code>http://127.0.0.1:5455/v1</code><span>OpenAI 兼容接口</span></div></div></div></div><p class="caption">功能示意 · 实际地址以客户端显示为准</p></section>
<section id="proxy" class="section wrap"><div class="section-heading"><p class="eyebrow">ONE PLACE, MORE POSSIBILITIES</p><h2>模型接入，集中使用。</h2><p>连接已有账号，使用本地代理，让模型接入你的工作流。</p></div><div class="connection"><div class="provider-stack">{providers.map(p=><div><img class="provider-icon" src={base + "/providers/" + p.icon} alt=""/><strong>{p.name}</strong><span>→</span></div>)}</div><span class="arrow">→</span><div class="connection-core"><img src={mascot} alt=""/><strong>小涛 XiaoTao</strong><span>模型接入 · 本地使用</span></div><span class="arrow last-arrow">→</span><div class="destination"><strong>你的工作空间</strong><div class="mini-window"><div></div><div><b></b><b></b><b></b><b></b></div></div><span>从接入，到开始工作</span></div></div></section>
<section id="tools" class="section wrap tools-section"><div class="section-heading"><p class="eyebrow">CONNECTED WITH YOUR TOOLS</p><h2>连接你熟悉的模型来源。</h2><p>可用模型和额度取决于各来源及账号权限。</p></div><div class="tools-grid">{providers.map(p=><article class="tool"><img class="provider-icon" src={base + "/providers/" + p.icon} alt=""/><h3>{p.name}</h3><p>通过小涛接入</p><span>支持的来源</span></article>)}</div></section>
<section id="partner" class="section partner"><div class="wrap"><div class="section-heading"><p class="eyebrow">MORE THAN A CONNECTION</p><h2>模型接入之后，管理也更轻松。</h2><p>从账号、模型到请求状态，常用信息集中查看。</p></div><div class="feature-grid">{features.map((f,i)=><article class="feature"><span class="number">0{i+1} /</span><h3>{f.title}</h3><p>{f.copy}</p><div class="feature-example"><strong>{f.heading}</strong>{f.items.map((item,j)=><div><span class={j===2?"blue-check":"check"}>✓</span>{item}</div>)}</div></article>)}</div></div></section>
<section class="section wrap scenario"><div><p class="eyebrow">GET STARTED</p><h2>三步接入，<br/>开始使用。</h2><p>在客户端添加模型账号，将本地代理配置到你常用的工具。</p><a class="text-link" href={repo + "/tree/master/xt-client"}>了解小涛客户端 →</a></div><ol class="steps">{[["添加账号","选择模型来源并完成账号授权。"],["查看模型和密钥","在客户端查看模型 ID，生成代理访问密钥。"],["配置你的工具","将本地 API 地址、密钥和模型 ID 填入兼容工具。"],["查看请求与用量","在小涛中查看请求状态和用量统计。"]].map(([title,text],i)=><li><span>0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></section>
<section class="closing"><div class="wrap closing-inner"><div><p class="eyebrow">MEET YOUR NEXT PROJECT COMPANION</p><h2>认识小涛，<br/>从接入开始。</h2><p>连接模型账号，把本地代理接入你的工具。</p><div class="actions"><a class="button primary" href={downloadUrl}>下载 Windows 客户端 ↓</a><a class="button secondary" href={repo}>GitHub ↗</a></div></div><img src={mascot} alt="小涛等你一起开启项目" loading="lazy"/></div></section>
</main>
<footer class="wrap"><a class="brand" href="#"><img src={mascot} alt=""/>小涛 <span>XiaoTao</span></a><p>多个模型来源，一个接入入口。</p><div><a href={repo}>GitHub ↗</a><a href={`${base}/skills/`}>Skills</a></div></footer>
<script>
document.querySelectorAll<HTMLButtonElement>("[data-provider]").forEach(button=>button.addEventListener("click",()=>{document.querySelectorAll("[data-provider]").forEach(item=>{item.classList.toggle("active",item===button);item.setAttribute("aria-pressed",String(item===button));});const label=document.querySelector("[data-provider-label]");if(label)label.textContent=button.dataset.provider??"Codex";}));
const toggle=document.querySelector<HTMLButtonElement>(".menu");const nav=document.querySelector("#navigation");toggle?.addEventListener("click",()=>{const open=toggle.getAttribute("aria-expanded")!=="true";toggle.setAttribute("aria-expanded",String(open));toggle.setAttribute("aria-label",open?"关闭导航":"打开导航");nav?.classList.toggle("open",open);});nav?.querySelectorAll("a").forEach(a=>a.addEventListener("click",()=>{toggle?.setAttribute("aria-expanded","false");nav.classList.remove("open");}));
</script>
</body></html>
