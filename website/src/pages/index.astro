---
import '../styles/global.css';

const repo = 'https://github.com/IHongTaoI/xiaotao';
const capabilities = [
  { index: '01', title: '一个入口', lead: '只和小涛沟通', text: '不需要挑选专家，也不用跟踪内部过程。小涛负责理解目标、确认边界、组织执行，最后只把结果和真正需要你决定的事带回来。', tag: 'Xiao Tao' },
  { index: '02', title: '动态执行', lead: '让合适的 Worker 做合适的事', text: '调查、实现、验证按能力拆成边界明确的工作单元。每次委派都有目标、权限与交付格式，不靠固定角色堆叠复杂度。', tag: 'Workers · Handoff' },
  { index: '03', title: '持续记忆', lead: '项目知道自己经历过什么', text: '探索留在 Temporary，正式工作进入 Task，稳定经验沉淀为 Long-term。Memory Worker 负责整理候选，人和主协调者保留最终判断。', tag: '3-layer Memory' },
  { index: '04', title: '随时恢复', lead: '会话结束，工作不断线', text: 'Checkpoint 保存可恢复状态，Handoff 压缩执行结果。换会话、压缩上下文或暂时离开，都能从项目里的真实状态继续。', tag: 'Checkpoint' },
];

const flow = [
  ['01', '说出目标', '用自然语言描述你想要的结果'],
  ['02', '先查记忆', '找到相关历史、决定与未完成工作'],
  ['03', '动态协作', '选择或生成边界清晰的 Workers'],
  ['04', '执行验证', '调查、实现、测试，并收敛证据'],
  ['05', '只报结果', '小涛汇总结论、风险与下一步'],
  ['06', '沉淀经验', '更新任务状态和长期项目记忆'],
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="XiaoTao 是面向结果、带项目记忆的 AI 软件协作工作流。只说目标，剩下的交给小涛。" />
    <meta name="theme-color" content="#07090d" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <title>XiaoTao — 只说目标，剩下的交给小涛</title>
  </head>
  <body>
    <div class="page-noise" aria-hidden="true"></div>
    <header class="nav shell">
      <a class="brand" href="#top" aria-label="XiaoTao 首页">
        <span class="brand-mark">M</span><span>XiaoTao</span>
      </a>
      <nav aria-label="主导航">
        <a href="#principles">理念</a><a href="#workflow">流程</a><a href="#architecture">架构</a><a href="#start">开始</a>
      </nav>
      <a class="nav-github" href={repo} target="_blank" rel="noreferrer">GitHub <span>↗</span></a>
    </header>

    <main id="top">
      <section class="hero shell">
        <div class="eyebrow reveal"><span class="status-dot"></span> Persistent AI collaboration</div>
        <h1 class="reveal delay-1">只说目标，<br /><span>剩下的交给小涛。</span></h1>
        <p class="hero-copy reveal delay-2">XiaoTao 是面向结果、带项目记忆的 AI 软件协作工作流。<br />一个入口，动态协作，跨会话持续推进。</p>
        <div class="hero-actions reveal delay-3">
          <a class="button primary" href="#start">快速开始 <span>→</span></a>
          <a class="button secondary" href={repo} target="_blank" rel="noreferrer">查看 GitHub <span>↗</span></a>
        </div>

        <div class="orchestra reveal delay-3" aria-label="XiaoTao 工作关系示意图">
          <div class="orbital-ring ring-one"></div><div class="orbital-ring ring-two"></div>
          <div class="orbit-node node-memory"><i></i><span>Memory</span></div>
          <div class="orbit-node node-worker"><i></i><span>Worker</span></div>
          <div class="orbit-node node-handoff"><i></i><span>Handoff</span></div>
          <div class="orbit-node node-checkpoint"><i></i><span>Checkpoint</span></div>
          <div class="core-node"><span class="core-glow"></span><small>YOUR INTERFACE</small><strong>小涛</strong><em>XIAO TAO</em></div>
          <svg class="connections" viewBox="0 0 900 420" aria-hidden="true">
            <path d="M450 210 C330 200 260 105 148 92"/><path d="M450 210 C570 185 665 92 760 92"/><path d="M450 210 C320 230 250 325 145 330"/><path d="M450 210 C585 240 650 332 765 330"/>
          </svg>
        </div>
        <div class="hero-fade"></div>
      </section>

      <section id="principles" class="section shell">
        <div class="section-head">
          <div><span class="kicker">01 / Philosophy</span><h2>复杂留在系统里，<br />清晰留给你。</h2></div>
          <p>XiaoTao 不要求你学习一套复杂流程。你只需要表达目标，内部的记忆、委派与恢复机制负责让工作可靠地继续。</p>
        </div>
        <div class="principle-grid">
          <article class="principle"><span>RESULTS</span><div class="principle-icon result-icon"><i></i><i></i><i></i></div><h3>结果优先</h3><p>先给结论、风险和决策，不用实现过程淹没对话。</p></article>
          <article class="principle"><span>MEMORY</span><div class="principle-icon memory-icon"><i></i><i></i><i></i></div><h3>项目记忆</h3><p>记忆保存在项目中，不被一次会话或某个平台锁住。</p></article>
          <article class="principle"><span>ORCHESTRATION</span><div class="principle-icon worker-icon"><i></i><i></i><i></i><i></i></div><h3>动态协作</h3><p>按任务生成执行能力，不维护一套僵硬的固定角色。</p></article>
        </div>
      </section>

      <section id="workflow" class="section workflow-section">
        <div class="shell">
          <div class="section-head compact"><div><span class="kicker">02 / Workflow</span><h2>从一句话，到可持续的结果。</h2></div></div>
          <div class="flow-list">
            {flow.map(([n, title, text]) => <article class="flow-item"><span>{n}</span><h3>{title}</h3><p>{text}</p><i>→</i></article>)}
          </div>
        </div>
      </section>

      <section id="architecture" class="section shell">
        <div class="section-head">
          <div><span class="kicker">03 / Architecture</span><h2>一个 Core，<br />连接不同 AI 宿主。</h2></div>
          <p>规则、记忆与协作模型属于项目。Adapter 只负责连接宿主能力，让 XiaoTao 不依赖某一个聊天窗口。</p>
        </div>
        <div class="architecture-card">
          <div class="arch-row user-row"><span class="arch-label">USER LAYER</span><div class="arch-main"><small>唯一用户入口</small><strong>小涛 · Xiao Tao</strong><p>理解目标 · 确认授权 · 判断结果 · 大白话汇报</p></div></div>
          <div class="arch-links"><i></i><i></i><i></i><i></i></div>
          <div class="arch-row collaboration-row"><span class="arch-label">COLLABORATION</span><div class="arch-cells"><div>Workers<small>动态执行</small></div><div>Memory Worker<small>记忆整理</small></div><div>Checkpoint<small>状态恢复</small></div><div>Handoff<small>结果交接</small></div></div></div>
          <div class="arch-links three"><i></i><i></i><i></i></div>
          <div class="arch-row memory-row"><span class="arch-label">PROJECT STATE</span><div class="arch-cells three"><div>Temporary<small>探索</small></div><div>Task<small>正式工作</small></div><div>Long-term<small>稳定知识</small></div></div></div>
          <div class="host-line"><span>HOST ADAPTERS</span><div><b>Codex</b><b>DeepSeek Harness</b><b class="muted">More to come</b></div></div>
        </div>
      </section>

      <section id="capabilities" class="section shell">
        <div class="section-head compact"><div><span class="kicker">04 / Capabilities</span><h2>为长期协作设计，<br />不是一次性的对话技巧。</h2></div></div>
        <div class="capability-list">
          {capabilities.map((item) => <article class="capability"><div class="cap-index">{item.index}</div><div class="cap-title"><span>{item.title}</span><h3>{item.lead}</h3></div><p>{item.text}</p><div class="cap-tag">{item.tag}</div></article>)}
        </div>
      </section>

      <section class="section platforms shell">
        <div class="section-head compact"><div><span class="kicker">05 / Platforms</span><h2>在你正在使用的地方工作。</h2></div></div>
        <div class="platform-grid">
          <article><div class="platform-icon codex-icon">⌘</div><div><span>SUPPORTED</span><h3>Codex</h3><p>通过 Skill 与 Codex Adapter 接入会话上下文、项目记忆和原生协作能力。</p></div><a href={`${repo}/tree/master/adapters/codex`}>查看 Adapter ↗</a></article>
          <article><div class="platform-icon dsh-icon">D</div><div><span>SUPPORTED</span><h3>DeepSeek Harness</h3><p>接入 DSH 生命周期、运行时上下文、自动 Checkpoint 与可恢复事务。</p></div><a href={`${repo}/tree/master/adapters/deepseek-harness`}>查看 Adapter ↗</a></article>
        </div>
      </section>

      <section id="start" class="section start-section">
        <div class="shell start-grid">
          <div><span class="kicker">06 / Quick start</span><h2>从源码开始，<br />让项目拥有连续记忆。</h2><p>当前版本支持直接从仓库安装，无需等待 npm 发布。</p><a class="text-link" href={`${repo}#从源码安装无需发布-npm`}>查看完整安装说明 →</a></div>
          <div class="terminal" data-terminal>
            <div class="terminal-top"><div><i></i><i></i><i></i></div><span>terminal</span><button type="button" aria-label="复制命令">COPY</button></div>
            <pre><code><span class="comment"># 克隆并安装依赖</span>
<span class="prompt">$</span> git clone {repo}.git
<span class="prompt">$</span> cd xiaotao
<span class="prompt">$</span> npm install

<span class="comment"># 安装到 Codex</span>
<span class="prompt">$</span> npm run codex:install:local</code></pre>
          </div>
        </div>
      </section>

      <section class="final-cta shell">
        <div class="cta-glow"></div><span class="kicker">XiaoTao Workflow</span>
        <h2>让 AI 记得项目，<br />也记得为什么这样做。</h2>
        <p>一个入口。动态协作。持续记忆。</p>
        <div class="hero-actions"><a class="button primary" href={repo} target="_blank" rel="noreferrer">View on GitHub <span>↗</span></a><a class="button secondary" href={`${repo}/issues`} target="_blank" rel="noreferrer">Report an Issue</a></div>
      </section>
    </main>

    <footer class="footer shell"><a class="brand" href="#top"><span class="brand-mark">M</span><span>XiaoTao</span></a><p>Result-first workflow for persistent AI collaboration.</p><span>Open source on GitHub · MIT License</span></footer>

    <script>
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); }
      }), { threshold: 0.12 });
      document.querySelectorAll('.section-head, .principle, .flow-item, .capability, .architecture-card, .platform-grid article, .terminal').forEach((el) => { el.classList.add('scroll-reveal'); observer.observe(el); });
      const terminal = document.querySelector('[data-terminal]');
      const copyButton = terminal?.querySelector('button');
      copyButton?.addEventListener('click', async () => {
        const text = terminal?.querySelector('code')?.textContent ?? '';
        await navigator.clipboard.writeText(text);
        copyButton.textContent = 'COPIED'; setTimeout(() => { copyButton.textContent = 'COPY'; }, 1600);
      });
    </script>
  </body>
</html>
