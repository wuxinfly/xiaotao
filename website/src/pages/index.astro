---
import "../styles/global.css";
const repo = "https://github.com/wuxinfly/xiaotao";
const downloadUrl = "https://github.com/wuxinfly/xiaotao/releases/download/v1.0.2/xiaotao-v1.0.2.exe";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
const mascot = `${base}/mascot-ripple.png`;
const providers = [{ name: "Trae", mark: "T", icon: "trae.svg" }, { name: "Codex", mark: "◎", icon: "codex.png" }, { name: "Antigravity", mark: "✦", icon: "antigravity.svg" }, { name: "WorkBuddy", mark: "W", icon: "workbuddy.png" }, { name: "Qoder", mark: "Q", icon: "qoder.png" }];
const features = [
 {title:"提出目标",copy:"选择模型和项目，说出你想完成的事。",heading:"从一个问题开始",items:["选择工作目录","选择已接入的模型","描述任务目标"]},
 {title:"动手执行",copy:"Agent 可以查看文件、修改代码、运行验证，并支持停止任务。",heading:"让想法变成行动",items:["查看项目文件","修改代码","运行验证"]},
 {title:"账号与模型",copy:"在一个地方管理不同来源的账号，查看模型目录与配额。",heading:"熟悉的模型，放在一起用",items:["管理多个账号","查看模型目录","查看可用额度"]},
 {title:"掌握请求",copy:"通过仪表盘和请求浮窗查看用量与请求状态。",heading:"工作进展，看得见",items:["查看最近请求","了解模型用量","留意进行中的请求"]},
];
---
<!doctype html>
<html lang="zh-CN">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="小涛 XiaoTao Agent：连接多种模型来源，在本地项目中使用 AI Agent。"/><meta name="theme-color" content="#38bdf8"/><link rel="icon" href={mascot}/><title>小涛 XiaoTao Agent · 接入 AI，一起推进项目</title></head>
<body class="landing">
<header><div class="nav wrap"><a class="brand" href={`${base}/`}><img src={mascot} alt=""/>小涛 <span>XiaoTao</span></a><button class="menu" aria-label="打开导航" aria-controls="navigation" aria-expanded="false">☰</button><nav id="navigation"><a href="#proxy">模型接入</a><a href="#tools">模型来源</a><a href="#partner">小涛能做什么</a><a href={`${base}/skills/`}>Skills</a></nav><a class="github" href={repo}>GitHub ↗</a></div></header>
<main>
<section class="hero"><div class="wrap hero-inner"><div class="hero-copy"><p class="eyebrow">XIAOTAO FOR WINDOWS  /  V1.0.2</p><h1>你的 AI 工作空间</h1><h2>让想法落地，<br/><em>和小涛一起。</em></h2><p class="intro">连接多个模型来源，在一个工作空间里<br/>探索项目、修改代码、运行验证。</p><div class="actions"><a class="button primary" href={downloadUrl}>下载 Windows 客户端 <span>↓</span></a><a class="button secondary" href={repo}>查看 GitHub ↗</a></div><p class="download-note">Windows x64 · v1.0.2 体验版 · 下载后直接运行</p><div class="hero-tools">{providers.map(p=><span><img class="provider-icon" src={base + "/providers/" + p.icon} alt=""/>{p.name}</span>)}</div></div><img class="hero-mascot" src={mascot} alt="海浪环绕的小涛" fetchpriority="high"/><p class="hero-note">连接熟悉的工具，<br/>一起把想法变成结果。</p></div></section>
<section class="wrap demo-section" aria-label="小涛客户端界面示意"><div class="real-demo"><div class="real-top"><img src={mascot} alt=""/><strong>小涛</strong><span>你的 AI 工作空间</span><b>小涛 Agent</b><span>模型</span><span class="real-window">— &nbsp; □ &nbsp; ×</span></div><div class="real-body"><aside><strong>＋ &nbsp; 新会话</strong><p>项目 &nbsp;&nbsp;&nbsp; 会话</p><small>最近的会话</small><div>项目工作区</div><div>新会话</div><small class="real-local">◉ &nbsp; 本地工作区</small></aside><div class="real-main"><div class="real-title">新会话 <span>准备开始</span></div><div class="real-center"><img src={mascot} alt=""/><small>小涛 Agent</small><h3>今天想做什么？</h3><p>选一个项目，描述目标，剩下的交给我。</p><div class="real-suggestions"><span>看看这个项目里有什么</span><span>帮我找一个问题并修复</span><span>跑一遍测试看看哪里坏了</span></div><div class="real-input">描述你想完成的事…<div><span>◈ &nbsp; 默认工作目录</span><span>选择模型　⌄ &nbsp; ↑</span></div></div></div></div></div></div><p class="caption">界面示意 · 根据 v1.0.2 客户端绘制</p></section>
<section id="proxy" class="section wrap"><div class="section-heading"><p class="eyebrow">ONE PLACE, MORE POSSIBILITIES</p><h2>模型接入，集中使用。</h2><p>连接已有账号，使用本地代理，让模型接入你的工作流。</p></div><div class="connection"><div class="provider-stack">{providers.map(p=><div><img class="provider-icon" src={base + "/providers/" + p.icon} alt=""/><strong>{p.name}</strong><span>→</span></div>)}</div><span class="arrow">→</span><div class="connection-core"><img src={mascot} alt=""/><strong>小涛 XiaoTao</strong><span>模型接入 · 本地使用</span></div><span class="arrow last-arrow">→</span><div class="destination"><strong>你的工作空间</strong><div class="mini-window"><div></div><div><b></b><b></b><b></b><b></b></div></div><span>从接入，到开始工作</span></div></div></section>
<section id="tools" class="section wrap tools-section"><div class="section-heading"><p class="eyebrow">CONNECTED WITH YOUR TOOLS</p><h2>连接你熟悉的模型来源。</h2><p>可用模型和额度取决于各来源及账号权限。</p></div><div class="tools-grid">{providers.map(p=><article class="tool"><img class="provider-icon" src={base + "/providers/" + p.icon} alt=""/><h3>{p.name}</h3><p>通过小涛接入</p><span>支持的来源</span></article>)}</div></section>
<section id="partner" class="section partner"><div class="wrap"><div class="section-heading"><p class="eyebrow">MORE THAN A CONNECTION</p><h2>从一句话，到动手完成。</h2><p>从选择模型到执行任务，进展与用量都清晰可见。</p></div><div class="feature-grid">{features.map((f,i)=><article class="feature"><span class="number">0{i+1} /</span><h3>{f.title}</h3><p>{f.copy}</p><div class="feature-example"><strong>{f.heading}</strong>{f.items.map((item,j)=><div><span class={j===2?"blue-check":"check"}>✓</span>{item}</div>)}</div></article>)}</div></div></section>
<section class="section wrap scenario"><div><p class="eyebrow">FROM A QUESTION TO A RESULT</p><h2>一个问题，<br/>一步步解决。</h2><p>以排查构建失败为例，看看小涛如何推进任务。</p><a class="text-link" href={`${repo}/tree/master/xt-client`}>了解小涛客户端 →</a></div><ol class="steps">{[["接入来源，提出目标","“帮我排查这个项目的构建失败。”"],["调查原因，修改代码","梳理错误与相关文件，形成修改方案。"],["验证修复，汇总结果","检查修改效果，说明结果与待办事项。"],["查看结果，继续对话","查看执行结果，继续提出下一步任务。"]].map(([title,text],i)=><li><span>0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></section>
<section class="closing"><div class="wrap closing-inner"><div><p class="eyebrow">MEET YOUR NEXT PROJECT COMPANION</p><h2>认识小涛，<br/>从接入开始。</h2><p>连接熟悉的 AI，一起把想法变成结果。</p><div class="actions"><a class="button primary" href={downloadUrl}>下载 Windows 客户端 ↓</a><a class="button secondary" href={repo}>GitHub ↗</a></div></div><img src={mascot} alt="小涛等你一起开启项目" loading="lazy"/></div></section>
</main>
<footer class="wrap"><a class="brand" href="#"><img src={mascot} alt=""/>小涛 <span>XiaoTao</span></a><p>连接 AI，也连接每一次进展。</p><div><a href={repo}>GitHub ↗</a><a href={`${base}/skills/`}>Skills</a></div></footer>
<script>
document.querySelectorAll<HTMLButtonElement>("[data-provider]").forEach(button=>button.addEventListener("click",()=>{document.querySelectorAll("[data-provider]").forEach(item=>{item.classList.toggle("active",item===button);item.setAttribute("aria-pressed",String(item===button));});const label=document.querySelector("[data-provider-label]");if(label)label.textContent=button.dataset.provider??"Codex";}));
const toggle=document.querySelector<HTMLButtonElement>(".menu");const nav=document.querySelector("#navigation");toggle?.addEventListener("click",()=>{const open=toggle.getAttribute("aria-expanded")!=="true";toggle.setAttribute("aria-expanded",String(open));toggle.setAttribute("aria-label",open?"关闭导航":"打开导航");nav?.classList.toggle("open",open);});nav?.querySelectorAll("a").forEach(a=>a.addEventListener("click",()=>{toggle?.setAttribute("aria-expanded","false");nav.classList.remove("open");}));
</script>
</body></html>
