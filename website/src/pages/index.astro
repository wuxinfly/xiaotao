---
import "../styles/global.css";
const repo = "https://github.com/IHongTaoI/xiaotao";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
const mascot = `${base}/mascot-ripple.png`;
const providers = [{ name: "Trae", mark: "T", style: "trae" }, { name: "Codex", mark: "◎", style: "codex" }, { name: "Gemini", mark: "✦", style: "gemini" }, { name: "WorkBuddy", mark: "W", style: "buddy" }];
const features = [
 {title:"理解目标",copy:"说出你想做的事，小涛梳理目标与范围，让每一步都有方向。",heading:"把想法，变成明确的计划",items:["梳理需求与项目背景","确认范围与关键问题","整理下一步行动"]},
 {title:"组织协作",copy:"按任务需要组织分析、实现与验证，把进展和结果带回来。",heading:"一个目标，清晰推进",items:["分析项目与定位问题","实现修改方案","验证结果与交付"]},
 {title:"项目记忆",copy:"留下重要背景、关键决定和原因，减少一遍遍重新交代。",heading:"记住决定，也记住为什么",items:["沿用现有技术栈","优先复用已有组件","保存关键决定与经验"]},
 {title:"持续推进",copy:"依据保存的项目状态恢复工作，接着上次的进度继续。",heading:"上一次的进度，就是新起点",items:["已完成 · 问题调查","已完成 · 修改与验证","下一步 · 整理交付记录"]},
];
---
<!doctype html>
<html lang="zh-CN">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="小涛 XiaoTao Agent：连接 Trae、Codex、Gemini、WorkBuddy，结合任务协作与项目记忆，一起推进项目。"/><meta name="theme-color" content="#38bdf8"/><link rel="icon" href={mascot}/><title>小涛 XiaoTao Agent · 接入 AI，一起推进项目</title></head>
<body>
<header><div class="nav wrap"><a class="brand" href={`${base}/`}><img src={mascot} alt=""/>小涛 <span>XiaoTao</span></a><button class="menu" aria-label="打开导航" aria-controls="navigation" aria-expanded="false">☰</button><nav id="navigation"><a href="#proxy">反代能力</a><a href="#tools">支持工具</a><a href="#partner">伙伴特性</a><a href={`${repo}/tree/master/xt-skills`}>Skills ↗</a></nav><a class="github" href={repo}>GitHub ↗</a></div></header>
<main>
<section class="hero"><div class="wrap hero-inner"><div class="hero-copy"><p class="eyebrow">YOUR AI COMPANION, XIAOTAO</p><h1>小涛 <span>XiaoTao Agent</span></h1><h2>统一接入，<br/>和小涛一起推进项目。</h2><p class="intro">连接 Trae、Codex、Gemini、WorkBuddy，<br/>让熟悉的 AI 与项目记忆、任务协作相遇。</p><div class="actions"><a class="button primary" href="#proxy">了解反代能力 <span>→</span></a><a class="button secondary" href={repo}>查看 GitHub ↗</a></div><div class="hero-tools">{providers.map(p=><span><i class={p.style}>{p.mark}</i>{p.name}</span>)}</div></div><img class="hero-mascot" src={mascot} alt="海浪环绕的小涛" fetchpriority="high"/><p class="hero-note">连接熟悉的工具，<br/>一起把想法变成结果。</p></div></section>
<section class="wrap demo-section" aria-label="小涛概念界面"><div class="demo"><aside class="sidebar"><div class="app-brand"><img src={mascot} alt=""/>小涛 Agent</div><span class="selected">◈ &nbsp; 新建对话</span><span>▤ &nbsp; 项目空间</span><span>◷ &nbsp; 对话记录</span><span>▧ &nbsp; 项目记忆</span><small>你的项目协作伙伴</small></aside><div class="sources"><strong>接入来源</strong><div role="group" aria-label="选择演示来源">{providers.map((p,i)=><button class={`source ${i===1?"active":""}`} data-provider={p.name} aria-pressed={i===1}><i class={p.style}>{p.mark}</i><span>{p.name}</span><b></b></button>)}</div><p>多种来源<br/>同一个工作空间</p></div><div class="conversation"><div class="chat-head"><span><strong data-provider-label>Codex</strong> ⌄</span><span>项目：xiaotao-web</span></div><div class="chat-body"><p class="user-message">帮我梳理这个项目，并提出修改建议。</p><div class="assistant"><img src={mascot} alt="小涛"/><div><strong>小涛</strong><p>我们先从项目结构开始，再把下一步理清楚。</p><ul><li>项目结构梳理 <em>✓ 已完成</em></li><li>发现的主要问题 <em>✓ 已完成</em></li><li>修改建议 <em>✓ 已完成</em></li><li>下一步计划 <em class="pending">◌ 进行中</em></li></ul></div></div></div><div class="chat-input"><span>继续聊聊你的项目…</span><span class="send">↑</span></div></div></div><p class="caption">概念界面 · 功能示意</p></section>
<section id="proxy" class="section wrap"><div class="section-heading"><p class="eyebrow">ONE PLACE, MORE POSSIBILITIES</p><h2>反代接入，集中使用。</h2><p>把熟悉的工具接入小涛，在同一个入口开启工作。</p></div><div class="connection"><div class="provider-stack">{providers.map(p=><div><i class={p.style}>{p.mark}</i><strong>{p.name}</strong><span>→</span></div>)}</div><span class="arrow">→</span><div class="connection-core"><img src={mascot} alt=""/><strong>小涛 XiaoTao</strong><span>反代接入 · 集中使用</span></div><span class="arrow last-arrow">→</span><div class="destination"><strong>你的工作空间</strong><div class="mini-window"><div></div><div><b></b><b></b><b></b><b></b></div></div><span>从接入，到开始协作</span></div></div></section>
<section id="tools" class="section wrap tools-section"><div class="section-heading"><p class="eyebrow">CONNECTED WITH YOUR TOOLS</p><h2>连接你熟悉的工具。</h2><p>不同的工具，同一个小涛。</p></div><div class="tools-grid">{providers.map(p=><article class="tool"><i class={p.style}>{p.mark}</i><h3>{p.name}</h3><p>通过小涛反代接入</p><span>接入来源 ↗</span></article>)}</div></section>
<section id="partner" class="section partner"><div class="wrap"><div class="section-heading"><p class="eyebrow">MORE THAN A CONNECTION</p><h2>接入之后，一起把事情做完。</h2><p>从理解目标，到协作执行，再到记住项目里的重要决定。</p></div><div class="feature-grid">{features.map((f,i)=><article class="feature"><span class="number">0{i+1} /</span><h3>{f.title}</h3><p>{f.copy}</p><div class="feature-example"><strong>{f.heading}</strong>{f.items.map((item,j)=><div><span class={j===2?"blue-check":"check"}>✓</span>{item}</div>)}</div></article>)}</div></div></section>
<section class="section wrap scenario"><div><p class="eyebrow">FROM A QUESTION TO A RESULT</p><h2>一个问题，<br/>一步步解决。</h2><p>以排查构建失败为例，看看小涛如何推进任务。</p><a class="text-link" href={`${repo}/tree/master/xt-client`}>了解小涛客户端 →</a></div><ol class="steps">{[["接入来源，提出目标","“帮我排查这个项目的构建失败。”"],["调查原因，修改代码","梳理错误与相关文件，形成修改方案。"],["验证修复，汇总结果","检查修改效果，说明结果与待办事项。"],["保存记录，接着往下做","留下项目状态与关键决定，方便后续继续。"]].map(([title,text],i)=><li><span>0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></section>
<section class="closing"><div class="wrap closing-inner"><div><p class="eyebrow">MEET YOUR NEXT PROJECT COMPANION</p><h2>认识小涛，<br/>从接入开始。</h2><p>连接熟悉的 AI，一起把想法变成结果。</p><div class="actions"><a class="button primary" href={`${repo}/tree/master/xt-client#readme`}>查看使用说明 →</a><a class="button secondary" href={repo}>GitHub ↗</a></div></div><img src={mascot} alt="小涛等你一起开启项目" loading="lazy"/></div></section>
</main>
<footer class="wrap"><a class="brand" href="#"><img src={mascot} alt=""/>小涛 <span>XiaoTao</span></a><p>连接 AI，也连接每一次进展。</p><div><a href={repo}>GitHub ↗</a><a href={`${repo}/tree/master/xt-skills`}>Skills ↗</a></div></footer>
<script>
document.querySelectorAll<HTMLButtonElement>("[data-provider]").forEach(button=>button.addEventListener("click",()=>{document.querySelectorAll("[data-provider]").forEach(item=>{item.classList.toggle("active",item===button);item.setAttribute("aria-pressed",String(item===button));});const label=document.querySelector("[data-provider-label]");if(label)label.textContent=button.dataset.provider??"Codex";}));
const toggle=document.querySelector<HTMLButtonElement>(".menu");const nav=document.querySelector("#navigation");toggle?.addEventListener("click",()=>{const open=toggle.getAttribute("aria-expanded")!=="true";toggle.setAttribute("aria-expanded",String(open));toggle.setAttribute("aria-label",open?"关闭导航":"打开导航");nav?.classList.toggle("open",open);});nav?.querySelectorAll("a").forEach(a=>a.addEventListener("click",()=>{toggle?.setAttribute("aria-expanded","false");nav.classList.remove("open");}));
</script>
</body></html>
